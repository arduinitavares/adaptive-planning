# Copy to a private .env only if one does not already exist; otherwise edit it.
# Docker Compose uses .env for interpolation; shell variables take precedence.
# The base compose.yaml remains loopback-only. LAN access requires the explicit
# compose.lan.yaml overlay and the Docker host's actual RFC1918 IPv4 address.
# Required operator choice: leave empty until intentionally enabling trusted LAN.
ADAPTIVE_PLANNING_LAN_IP=

# For an existing deployment, preserve its exact Compose project name before
# any build or update. Uncomment and fill this if it used a project override;
# otherwise retain the same project directory and its default project name.
# COMPOSE_PROJECT_NAME=
